{
  "name": "bmcl-launcher",
  "productName": "fft1145",
  "version": "1.0.0",
  "description": "BMCL — 基于 PCL2 交互思路的 Minecraft 启动器（fft1145 定制版）",
  "main": "main.js",
  "author": "fft1145",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "cn.fft1145.bmcl",
    "productName": "fft1145",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "fft1145-${version}-portable.exe"
    }
  }
}
